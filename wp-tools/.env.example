# Kopiere diese Datei zu wp-tools/.env und trage echte Werte ein.
# wp-tools/.env ist in .gitignore -> wird NIE committet.
#
# Application Password in WordPress anlegen:
#   aumann-eco.de/wp-admin -> Benutzer -> Profil -> Anwendungspasswoerter
# Leerzeichen im Passwort sind ok (WordPress ignoriert sie).

WP_USER=ostend
WP_APP_PW=xxxx xxxx xxxx xxxx xxxx xxxx
